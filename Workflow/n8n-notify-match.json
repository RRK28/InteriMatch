        "jsCode": "const raw = items[0].json;\nconst body = raw.body || raw;\nconst type = body.type || raw.type;\nconst mission = body.mission || '';\nconst score = body.score ?? '';\nlet subject = '';\nlet html = '';\nif (type === 'high_match') {\n  subject = 'Nouveau match > 80% — ' + mission;\n  html = '<p>Bonjour,</p><p>Une mission <strong>' + mission + '</strong> a un match ≥ 80%.</p><p>Connecte-toi sur InteriMatch.</p>';\n} else if (type === 'relance') {\n  subject = 'Relance — mission encore ouverte sur InteriMatch';\n  html = '<p>Bonjour,</p><p>Tu as des missions encore ouvertes : <strong>' + mission + '</strong>.</p><p>Connecte-toi sur InteriMatch.</p>';\n} else {\n  subject = 'Candidature reçue — ' + mission;\n  html = '<p>Bonjour,</p><p>Candidature pour <strong>' + mission + '</strong> enregistrée (score ' + score + '/100).</p>';\n}\nreturn [{ json: { ...body, type, mission, score, subject, html } }];"
      },
