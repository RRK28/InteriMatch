{
  "name": "InteriMatch — relance missions ouvertes (Brevo)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 24 }]
        }
      },
      "id": "cron1",
      "name": "Tous les jours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTERIMATCH_API_URL }}/api/webhooks/relance-missions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-webhook-secret", "value": "={{ $env.WEBHOOK_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"days\": 7 }"
      },
      "id": "http1",
      "name": "API relance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "api-key", "value": "={{ $env.BREVO_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sender\": { \"name\": \"InteriMatch\", \"email\": \"{{ $env.BREVO_SENDER_EMAIL }}\" },\n  \"to\": [{ \"email\": \"{{ $json.missions[0].email }}\" }],\n  \"subject\": \"Relance — mission encore ouverte sur InteriMatch\",\n  \"htmlContent\": \"<p>Bonjour,</p><p>Tu as <strong>{{ $json.count }}</strong> mission(s) ouverte(s) depuis plus de 7 jours (ex. {{ $json.missions[0].titre }}).</p><p>Connecte-toi pour mettre à jour le statut ou accepter un candidat.</p>\"\n}"
      },
      "id": "brevo1",
      "name": "Brevo — mail relance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Tous les jours": {
      "main": [[{ "node": "API relance", "type": "main", "index": 0 }]]
    },
    "API relance": {
      "main": [[{ "node": "Brevo — mail relance", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "3"
}
