{
  "name": "InteriMatch — relance missions ouvertes (Brevo)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 24 }]
        }
      },
      "id": "cron1",
      "name": "Tous les jours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://interimatch-2q0a.onrender.com/api/webhooks/relance-missions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-webhook-secret", "value": "change-me" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"days\": 0 }",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http1",
      "name": "API relance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if1",
      "name": "IF missions à relancer",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "api-key", "value": "={{ $env.BREVO_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sender\": { \"name\": \"InteriMatch\", \"email\": \"leglitcher692@gmail.com\" },\n  \"to\": [{ \"email\": \"{{ $json.missions[0].email }}\" }],\n  \"subject\": \"Relance — mission encore ouverte sur InteriMatch\",\n  \"htmlContent\": \"<p>Bonjour,</p><p>Tu as <strong>{{ $json.count }}</strong> mission(s) ouverte(s) (ex. {{ $json.missions[0].titre }}).</p><p>Connecte-toi pour mettre à jour le statut ou accepter un candidat.</p>\"\n}"
      },
      "id": "brevo1",
      "name": "Brevo — mail relance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [920, 220]
    },
    {
      "parameters": {
        "content": "## Aucune mission à relancer\nPas d'email envoyé (normal si tout est à jour).",
        "height": 160,
        "width": 280
      },
      "id": "note1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [920, 400]
    }
  ],
  "connections": {
    "Tous les jours": {
      "main": [[{ "node": "API relance", "type": "main", "index": 0 }]]
    },
    "API relance": {
      "main": [[{ "node": "IF missions à relancer", "type": "main", "index": 0 }]]
    },
    "IF missions à relancer": {
      "main": [
        [{ "node": "Brevo — mail relance", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "4"
}
